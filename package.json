{
  "name": "zaomeng-rngcalc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "造梦西游3 随机数计算器 Web 前端（cracker.wasm + TS + Web Workers）",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build_singlefile.mjs --all && vite build && vite build --mode legacy",
    "build:local": "node tools/build_singlefile.mjs --all",
    "build:local:modern": "node tools/build_singlefile.mjs",
    "build:local:legacy": "node tools/build_singlefile.mjs --legacy",
    "build:web": "vite build",
    "build:legacy": "vite build --mode legacy",
    "build:ext": "node tools/build_extension.mjs",
    "build:ext:debug": "node tools/build_extension.mjs --no-minify",
    "build:ext:mv2": "node tools/build_extension.mjs --mv2",
    "build:ext:mv2:debug": "node tools/build_extension.mjs --mv2 --no-minify",
    "build:ext:all": "node tools/build_extension.mjs --all",
    "render:mechanics": "python tools/render_mechanics.py",
    "preview": "vite preview",
    "test": "node tools/vitest-run.mjs run",
    "test:ci": "node tools/vitest-run.mjs run --exclude tests/wasm_engine.test.ts --exclude tests/searcher.test.ts --exclude tests/scenario_runs.test.ts",
    "test:watch": "node tools/vitest-run.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:ci": "npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
